# ============================================================
# EnquadraMap 4.0 — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# ----------------------------------------------------------
# Google Maps Platform
# Obtenha em: https://console.cloud.google.com/
# APIs necessárias: Maps JavaScript API, Places API, Directions API
# ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------
# Vercel Postgres
# Gerado automaticamente ao criar/linkar o banco em:
# Vercel Dashboard → Storage → Create Database → Postgres
# ----------------------------------------------------------
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ----------------------------------------------------------
# Vercel Blob
# Gerado ao criar um Blob Store em:
# Vercel Dashboard → Storage → Create Store → Blob
# ----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
